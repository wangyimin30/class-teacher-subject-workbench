{
  "name": "teacher-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "教师工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "web": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && npm run electron\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "docx": "^9.5.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.12.0",
    "wait-on": "^8.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.teacherworkbench.app",
    "productName": "教师工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!data/**/*",
      "!node_modules/electron-builder/**/*",
      "!**/*.map",
      "!**/{.DS_Store,.git,.gitignore}"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
